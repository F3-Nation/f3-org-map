    "typescript": "~7.0.2",
    "vite": "npm:rolldown-vite@7.2.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "dependencies": {
